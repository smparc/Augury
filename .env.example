# Augury — environment template.
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.

# ---------------------------------------------------------------------------
# X (Twitter) API
# ---------------------------------------------------------------------------
# Pay-per-use as of 2026 (~$0.005 per post read). Ingestion defaults to the
# fixture backend and makes NO live calls unless AUGURY_X_LIVE=1.
X_BEARER_TOKEN=
AUGURY_X_LIVE=0
# Hard ceiling on live post reads per UTC day. Enforced in both augury-signal
# and augury-ingest against a persisted counter, so a restart cannot reset it.
MAX_DAILY_READS=2000

# ---------------------------------------------------------------------------
# Prediction market data (public, unauthenticated — no keys required)
# ---------------------------------------------------------------------------
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com

# ---------------------------------------------------------------------------
# TimescaleDB / Postgres
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=augury
POSTGRES_USER=augury
POSTGRES_PASSWORD=augury_local_dev
# Full URL is derived from the parts above by the Python/Rust config loaders;
# set it explicitly only to point at a database that isn't the docker one.
DATABASE_URL=postgresql://augury:augury_local_dev@localhost:5432/augury

# ---------------------------------------------------------------------------
# Redis (cross-service pub/sub: stance signals and simulated price ticks)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Signal model
# ---------------------------------------------------------------------------
# Baseline S(t) half-life in hours. Adaptive decay shortens this during
# high-volatility windows down to SIGNAL_HALF_LIFE_MIN_HOURS.
SIGNAL_HALF_LIFE_HOURS=6.0
SIGNAL_HALF_LIFE_MIN_HOURS=0.5
# Stance backend: `vader` (lexicon baseline) or `deberta` (target-conditioned).
STANCE_MODEL=vader
STANCE_MODEL_NAME=microsoft/deberta-v3-base
STANCE_DEVICE=cpu

# ---------------------------------------------------------------------------
# Services
# ---------------------------------------------------------------------------
AUGURY_API_PORT=8080
AUGURY_ENGINE_TICK_MS=1000
LOG_LEVEL=info
